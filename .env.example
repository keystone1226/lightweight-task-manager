# Interview Insights 서버 환경변수
# 이 파일을 복사해서 .env 로 저장한 뒤 값을 채워주세요.
# cp .env.example .env

# Anthropic API 키 (필수) — https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# 서버 포트 (선택, 기본값: 8000)
# PORT=8000

# 주간보고 LLM 설정 (필수 - 사내 LLM API)
TASK_LLM_URL=https://llm.company.internal/v1/chat/completions
TASK_LLM_TOKEN=your-bearer-token-here
TASK_LLM_MODEL=gpt-4o
